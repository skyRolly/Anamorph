  "runner_source": "import collections, datetime, hashlib, json, os, pathlib, re, subprocess, sys, tempfile\nfrom zoneinfo import ZoneInfo\n\nroot = pathlib.Path('/workspace/Anamorph')\nbuild = pathlib.Path('/workspace/build-post-b2-main')\nout = pathlib.Path('/workspace/scratch/post-b2')\nsys.path.insert(0, str(root / 'scripts'))\nfrom native_validation import command_args, output_path, with_output\n\nexpected = '2b256e90adab35077fa5906419743ee6a69c606e'\ndef git(*args, where=root):\n    return subprocess.check_output(['git', '-C', str(where), *args], text=True).strip()\ndef sha(p):\n    return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()\nassert git('rev-parse', 'HEAD') == expected\nsubprocess.run(['git', '-C', str(root), 'diff', '--quiet', expected, '--', 'src', 'tests', 'CMakeLists.txt', 'cmake'], check=True)\nassert git('rev-parse', 'HEAD', where=pathlib.Path('/workspace/.cloud-setup/deps/JUCE905')) == 'd60b7a78030661574a615b586d9325ba7a7fa7dd'\ncommands = [command_args(s, False) for s in subprocess.check_output(['ninja', '-C', str(build), '-t', 'commands', 'AnamorphStateTests'], text=True).splitlines()]\nstate = next(c for c in commands if '-c' in c and str(root / 'tests/state_tests.cpp') in c)\nlink = next(c for c in commands if '-c' not in c and '-o' in c and 'AnamorphStateTests_artefacts/' in output_path(c))\ncompile_witness = with_output([str(out / 'path-witness.cpp') if x == str(root / 'tests/state_tests.cpp') else x for x in state], out / 'path-witness.o')\nlink_witness = with_output([str(out / 'path-witness.o') if x == output_path(state) else x for x in link], out / 'path-witness')\nsubprocess.run(compile_witness, cwd=build, check=True)\nsubprocess.run(link_witness, cwd=build, check=True)\nbinary = build / 'AnamorphStateTests_artefacts/Release/AnamorphStateTests'\ndsp = build / 'AnamorphTests_artefacts/Release/AnamorphTests'\nmanifest = {'source_commit': expected, 'reviewed_head': '5888bb6578aa2ead92cc8b862da6a2349190a407',\n            'recorded_at': datetime.datetime.now(ZoneInfo('Asia/Shanghai')).isoformat(),\n            'classification': 'Actual integrated main; Linux GCC14 component verification, not native DAW/processor-destruction acceptance',\n            'compile_witness': compile_witness, 'link_witness': link_witness,\n            'state_binary_sha256': sha(binary), 'dsp_binary_sha256': sha(dsp),\n            'witness_binary_sha256': sha(out / 'path-witness'),\n            'witness_source': (out / 'path-witness.cpp').read_text(),\n            'source_hashes': {str(p.relative_to(root)): sha(p) for name in git('ls-files', 'src', 'tests', 'CMakeLists.txt', 'cmake').splitlines() if (p := root / name).is_file()},\n            'compiler': subprocess.check_output(['c++', '--version'], text=True).splitlines()[0],\n            'juce': git('rev-parse', 'HEAD', where=pathlib.Path('/workspace/.cloud-setup/deps/JUCE905'))}\ndef environment(profile):\n    home = profile / 'home'; config = home / '.config'; temp = profile / 'temp'\n    config.mkdir(parents=True); temp.mkdir()\n    return dict(os.environ, HOME=str(home), XDG_CONFIG_HOME=str(config), TMPDIR=str(temp)), config, temp\ndef witness(env):\n    result = subprocess.run([str(out / 'path-witness')], env=env, capture_output=True, text=True, check=True)\n    return dict(line.split('=', 1) for line in result.stdout.splitlines())\ndef verify(paths, config, temp):\n    return all(pathlib.Path(paths[k]).resolve() == value.resolve() for k, value in\n               [('APPDATA', config), ('PRESETS', config / 'RollyTech/Anamorph/Presets'), ('TEMP', temp)])\nwith tempfile.TemporaryDirectory(prefix='main-profile-', dir=out) as temporary:\n    base = pathlib.Path(temporary); a = base / 'accepted'; b = base / 'other-owned-profile'; a.mkdir(); b.mkdir()\n    env, config, temp = environment(a); other_env, _, _ = environment(b)\n    wrong = witness(other_env)\n    assert not verify(wrong, config, temp), 'wrong-profile control was accepted'\n    paths = witness(env); assert verify(paths, config, temp), paths\n    manifest['path_witness'] = paths; manifest['wrong_owned_profile_control'] = {'rejected': True, 'observed': wrong}\n    for name, argv in [('main-focused', ['xvfb-run', '-a', str(binary), '--knob-lifetime-probe']), ('main-dsp', [str(dsp)])]:\n        result = subprocess.run(argv, cwd=root, env=env, capture_output=True, timeout=600)\n        (out / (name + '.stdout')).write_bytes(result.stdout); (out / (name + '.stderr')).write_bytes(result.stderr)\n        text = result.stdout.decode(errors='replace') + result.stderr.decode(errors='replace')\n        record = {'argv': argv, 'exit': result.returncode, 'stdout_sha256': hashlib.sha256(result.stdout).hexdigest(), 'stderr_sha256': hashlib.sha256(result.stderr).hexdigest()}\n        assert result.returncode == 0, record\n        if name == 'main-focused':\n            rows = re.findall(r'B2 target=.*?begin=(\\d+) end=(\\d+)', text)\n            assert len(rows) == 166, len(rows)\n            record['matrix_rows'] = len(rows); record['gesture_pairs'] = dict(collections.Counter('/'.join(r) for r in rows))\n            assert '2443 checks, 0 failure(s)' in text, text[-500:]\n            record['checks'] = 2443\n        else:\n            assert '945 checks, 0 failures' in text, text[-500:]\n            record['checks'] = 945\n        manifest[name] = record; print(name, json.dumps(record), flush=True)\nassert git('rev-parse', 'HEAD') == expected\nsubprocess.run(['git', '-C', str(root), 'diff', '--quiet', expected, '--', 'src', 'tests', 'CMakeLists.txt', 'cmake'], check=True)\n(out / 'main-validation.json').write_text(json.dumps(manifest, indent=2) + '\\n')\n",
