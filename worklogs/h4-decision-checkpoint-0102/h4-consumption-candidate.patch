diff --git a/src/dsp/MultibandWidth.h b/src/dsp/MultibandWidth.h
index 3812a484..3bbae18a 100644
--- a/src/dsp/MultibandWidth.h
+++ b/src/dsp/MultibandWidth.h
@@ -52,0 +53,25 @@ public:
+    // Diagnostic A2: dry state only; leave wet, coefficients, widths and fades intact.
+    void resetDryChannel (int channel) noexcept
+    {
+        for (auto& b : bank)
+            for (int i = 0; i < 3; ++i)
+            {
+                b.dx[i].resetChannel (channel);
+                b.dax[i].resetChannel (channel);
+            }
+    }
+
+    // Nonshipping experiment: inspect precisely the dry states processed in
+    // the last block, including a fade source that retired during that block.
+    bool dryChannelFinite (int channel) const noexcept
+    {
+        const int crossovers = bands - 1;
+        for (int b = 0; b < 2; ++b)
+            if ((lastDryBankMask & (1 << b)) != 0)
+                for (int i = 0; i < crossovers; ++i)
+                    if (! bank[b].dx[i].stateFinite (channel)
+                        || (i > 0 && ! bank[b].dax[i].firstSectionFinite (channel)))
+                        return false;
+        return true;
+    }
+
@@ -169,0 +195 @@ private:
+    int       lastDryBankMask = 0; // diagnostic: banks actually used in last aligned block
