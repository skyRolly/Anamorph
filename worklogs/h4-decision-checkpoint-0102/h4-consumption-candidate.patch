diff --git a/src/dsp/AnamorphEngine.cpp b/src/dsp/AnamorphEngine.cpp
index 044a63bb..4b178c9b 100644
--- a/src/dsp/AnamorphEngine.cpp
+++ b/src/dsp/AnamorphEngine.cpp
@@ -1943,3 +1943,6 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
-        if (fullWetIdle)
-            multiband.processBlock (L, R, n); // dry bank skipped (null dry pointers)
-        else
+        // Nonshipping experiment: maintain dry state and validate consumed
+        // state/output before either aligned history or Mix can consume it.
+        multiband.processBlock (L, R, n,
+            dryScratch.getReadPointer (0), dryScratch.getReadPointer (1),
+            dryAlignScratch.getWritePointer (0), dryAlignScratch.getWritePointer (1));
+        for (int channel = 0; channel < 2; ++channel)
@@ -1947,4 +1950,14 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
-            multiband.processBlock (L, R, n,
-                dryScratch.getReadPointer (0), dryScratch.getReadPointer (1),
-                dryAlignScratch.getWritePointer (0), dryAlignScratch.getWritePointer (1));
-            dryAligned = true;
+            float* d = dryAlignScratch.getWritePointer (channel);
+            uint32_t worst = 0;
+            for (int i = 0; i < n; ++i)
+            {
+                uint32_t bits; std::memcpy (&bits, d + i, sizeof (bits));
+                bits &= 0x7f800000u;
+                worst = worst > bits ? worst : bits;
+            }
+            if (worst == 0x7f800000u || ! multiband.dryChannelFinite (channel))
+            {
+                for (int i = 0; i < n; ++i)
+                    if (! std::isfinite (d[i])) d[i] = 0.0f;
+                multiband.resetDryChannel (channel);
+            }
@@ -1951,0 +1965 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
+        dryAligned = true;
@@ -2038 +2052 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
-            lrL[i] = adL[rp]; lrR[i] = adR[rp];
+            lrL[i] = ddL[rp]; lrR[i] = ddR[rp]; // retain H4 clean-dry measurement policy
diff --git a/src/dsp/LR4Xover.h b/src/dsp/LR4Xover.h
index 73a6ec2b..b97a567e 100644
--- a/src/dsp/LR4Xover.h
+++ b/src/dsp/LR4Xover.h
@@ -43,0 +44,6 @@ public:
+    // Diagnostic A2: clear only the failed channel's recursive state.
+    void resetChannel (int channel) noexcept
+    {
+        s1[channel] = s2[channel] = s3[channel] = s4[channel] = 0.0f;
+    }
+
@@ -49,0 +56,13 @@ public:
+    // Diagnostic only: inspect all recursive state in this channel.
+    bool stateFinite (int channel) const noexcept
+    {
+        return std::isfinite (s1[channel]) && std::isfinite (s2[channel])
+            && std::isfinite (s3[channel]) && std::isfinite (s4[channel]);
+    }
+
+    // Nonshipping experiment: only these states are consumed by allpass processing.
+    bool firstSectionFinite (int channel) const noexcept
+    {
+        return std::isfinite (s1[channel]) && std::isfinite (s2[channel]);
+    }
+
diff --git a/src/dsp/MultibandWidth.cpp b/src/dsp/MultibandWidth.cpp
