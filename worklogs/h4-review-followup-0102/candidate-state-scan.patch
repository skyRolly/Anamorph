diff --git a/src/dsp/AnamorphEngine.cpp b/src/dsp/AnamorphEngine.cpp
index 044a63bb..acabeed9 100644
--- a/src/dsp/AnamorphEngine.cpp
+++ b/src/dsp/AnamorphEngine.cpp
@@ -1941,7 +1941,33 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
         }
 
         if (fullWetIdle)
-            multiband.processBlock (L, R, n); // dry bank skipped (null dry pointers)
+        {
+            multiband.processBlock (L, R, n,
+                dryScratch.getReadPointer (0), dryScratch.getReadPointer (1),
+                dryAlignScratch.getWritePointer (0), dryAlignScratch.getWritePointer (1));
+            // Diagnostic A2: unused output still owns live recursive state. Detect
+            // exceptional values before any can enter aligned history, then reset
+            // only the failed dry channel. All prior ring writes are finite by
+            // this gate or the existing consuming-path self-heal.
+            for (int channel = 0; channel < 2; ++channel)
+            {
+                float* d = dryAlignScratch.getWritePointer (channel);
+                uint32_t worst = 0;
+                for (int i = 0; i < n; ++i)
+                {
+                    uint32_t bits; std::memcpy (&bits, d + i, sizeof (bits));
+                    bits &= 0x7f800000u;
+                    worst = worst > bits ? worst : bits;
+                }
+                if (worst == 0x7f800000u || ! multiband.dryChannelFinite (channel))
+                {
+                    for (int i = 0; i < n; ++i)
+                        if (! std::isfinite (d[i])) d[i] = 0.0f;
+                    multiband.resetDryChannel (channel);
+                }
+            }
+            dryAligned = true; // maintain filter AND finite aligned-delay history
+        }
         else
         {
             multiband.processBlock (L, R, n,
@@ -2035,7 +2061,7 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
             adL[dryDelayWrite] = aL[i];
             adR[dryDelayWrite] = aR[i];
             int rp = dryDelayWrite - lat; if (rp < 0) rp += ddSize;
-            lrL[i] = adL[rp]; lrR[i] = adR[rp];
+            lrL[i] = ddL[rp]; lrR[i] = ddR[rp]; // retain H4 clean-dry measurement policy
             if (++dryDelayWrite >= ddSize) dryDelayWrite = 0;
         }
     }
