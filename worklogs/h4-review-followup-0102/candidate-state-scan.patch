         s3[0] = s3[1] = s4[0] = s4[1] = 0.0f;
     }
 
+    // Diagnostic A2: clear only the failed channel's recursive state.
+    void resetChannel (int channel) noexcept
+    {
+        s1[channel] = s2[channel] = s3[channel] = s4[channel] = 0.0f;
+    }
+
     void setCutoffFrequency (float newCutoffFrequencyHz) noexcept
     {
         cutoffFrequency = newCutoffFrequencyHz;
         update();
     }
 
+    // Diagnostic only: inspect all recursive state in this channel.
+    bool stateFinite (int channel) const noexcept
+    {
+        return std::isfinite (s1[channel]) && std::isfinite (s2[channel])
+            && std::isfinite (s3[channel]) && std::isfinite (s4[channel]);
+    }
+
     // Adopt another crossover's ladder state (coefficients untouched). Used by
     // the fixed-cutoff bank crossfade: the incoming bank continues the outgoing
     // bank's integrator history, so its first samples carry no charge-up
diff --git a/src/dsp/MultibandWidth.h b/src/dsp/MultibandWidth.h
index 3812a484..e2137526 100644
--- a/src/dsp/MultibandWidth.h
+++ b/src/dsp/MultibandWidth.h
@@ -50,6 +50,27 @@ public:
     void prepare (double sampleRate, int maxBlock);
     void reset();
 
+    // Diagnostic A2: dry state only; leave wet, coefficients, widths and fades intact.
+    void resetDryChannel (int channel) noexcept
+    {
+        for (auto& b : bank)
+            for (int i = 0; i < 3; ++i)
+            {
+                b.dx[i].resetChannel (channel);
+                b.dax[i].resetChannel (channel);
+            }
+    }
+
+    // Diagnostic only: check dry states in both crossover banks.
+    bool dryChannelFinite (int channel) const noexcept
+    {
+        for (const auto& b : bank)
+            for (int i = 0; i < 3; ++i)
+                if (! b.dx[i].stateFinite (channel) || ! b.dax[i].stateFinite (channel))
+                    return false;
+        return true;
+    }
+
