@@ -1,0 +2 @@
+#include <cstdio>
@@ -1416,0 +1418,17 @@ void AnamorphEngine::process (juce::AudioBuffer<float>& buffer) noexcept ANAMORP
+    // Nonshipping, synchronous causal trace; never use this build for timing.
+    auto h4Trace = [L, R, n] (const char* stage) noexcept
+    {
+        int badL = 0, badR = 0, firstL = -1, firstR = -1;
+        float peakL = 0.0f, peakR = 0.0f;
+        for (int i = 0; i < n; ++i)
+        {
+            if (! std::isfinite (L[i])) { ++badL; if (firstL < 0) firstL = i; }
+            else peakL = std::max (peakL, std::abs (L[i]));
+            if (! std::isfinite (R[i])) { ++badR; if (firstR < 0) firstR = i; }
+            else peakR = std::max (peakR, std::abs (R[i]));
+        }
+        if (badL || badR || peakL > 1.0e37f || peakR > 1.0e37f)
+            std::fprintf (stderr, "H4TRACE %s bad=%d,%d first=%d,%d peak=%g,%g\n",
+                          stage, badL, badR, firstL, firstR, peakL, peakR);
+    };
+
