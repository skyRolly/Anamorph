# Compile all standard 1x/2x representations without modifying the B0 sources.
# Called after JUCE's configure-time generation, and by the bundle build graph.
cmake_minimum_required(VERSION 3.22)
foreach(input BIG SMALL OUTPUT)
    if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
        message(FATAL_ERROR "Missing macOS icon generator argument: ${input}")
    endif()
endforeach()
if(NOT EXISTS "${BIG}" OR NOT EXISTS "${SMALL}")
    message(FATAL_ERROR "Missing approved macOS icon source")
endif()

function(native_tool)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
        OUTPUT_QUIET ERROR_VARIABLE diagnostic)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "macOS icon generation failed (${ARGV0}): ${diagnostic}")
    endif()
endfunction()

get_filename_component(directory "${OUTPUT}" DIRECTORY)
set(iconset "${directory}/Anamorph.iconset")
file(MAKE_DIRECTORY "${iconset}")
foreach(points 16 32 128 256 512)
    foreach(scale 1 2)
        math(EXPR pixels "${points} * ${scale}")
        set(suffix "")
        if(scale EQUAL 2)
            set(suffix "@2x")
        endif()
        set(destination "${iconset}/icon_${points}x${points}${suffix}.png")
        if(pixels LESS_EQUAL 32)
            set(source "${SMALL}")
            set(source_size 32)
        else()
            set(source "${BIG}")
            set(source_size 1024)
        endif()
        if(pixels EQUAL source_size)
            configure_file("${source}" "${destination}" COPYONLY)
        else()
            native_tool(/usr/bin/sips --resampleHeightWidth "${pixels}" "${pixels}"
                "${source}" --out "${destination}")
        endif()
    endforeach()
endforeach()
native_tool(/usr/bin/iconutil --convert icns --output "${OUTPUT}.pending.icns" "${iconset}")
file(RENAME "${OUTPUT}.pending.icns" "${OUTPUT}")
